From 78fd44e022b9a14b9336ca903af13ce82b162d27 Mon Sep 17 00:00:00 2001
From: Jim Chen <czcbangkai@google.com>
Date: Wed, 21 Oct 2026 14:27:45 +0000
Subject: [PATCH] nfs4_op_sequence: Fix slot->sequence use-after-free on
 illegal replay

In nfs4_op_sequence(), when handling an illegal uncached replay
(slot->sequence == arg_SEQUENCE4->sa_sequenceid &&
slot->cached_result == NULL), PTHREAD_MUTEX_unlock(&slot->slot_lock)
and dec_session_ref(session) were called before LogDebugAlt() accessed
slot->sequence. Since slot points into session->fc_slots, dropping the
last reference to session frees both session and slot before
LogDebugAlt() reads slot->sequence.

Log the error while still holding slot->slot_lock and the session
reference, then unlock and call dec_session_ref(session).

Change-Id: I11358de77f344c3843704d328a85c5c90f3a8dc5
Signed-off-by: Jim Chen <czcbangkai@google.com>
---
 src/Protocols/NFS/nfs4_op_sequence.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/Protocols/NFS/nfs4_op_sequence.c b/src/Protocols/NFS/nfs4_op_sequence.c
index 11e7ddcd76..49fc6875bd 100644
--- a/src/Protocols/NFS/nfs4_op_sequence.c
+++ b/src/Protocols/NFS/nfs4_op_sequence.c
@@ -268,9 +268,6 @@ enum nfs_req_result nfs4_op_sequence(struct nfs_argop4 *op,
 				return NFS_REQ_REPLAY;
 			} else {
 				/* Illegal replay */
-				PTHREAD_MUTEX_unlock(&slot->slot_lock);
-
-				dec_session_ref(session);
 				res_SEQUENCE4->sr_status =
 					NFS4ERR_RETRY_UNCACHED_REP;
 				LogDebugAlt(
@@ -281,6 +278,9 @@ enum nfs_req_result nfs4_op_sequence(struct nfs_argop4 *op,
 						res_SEQUENCE4->sr_status),
 					slot->sequence,
 					arg_SEQUENCE4->sa_sequenceid);
+				PTHREAD_MUTEX_unlock(&slot->slot_lock);
+
+				dec_session_ref(session);
 				return NFS_REQ_ERROR;
 			}
 		}
